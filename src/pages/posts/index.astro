---
import { getCollection } from "astro:content";

import PostCard from "../../components/PostCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPublishedPosts } from "../../utils/posts";

const posts = getPublishedPosts(await getCollection("posts"));
---

<BaseLayout title="posts" description="Every public note from Nimdal's personal blog, sorted from newest to oldest." canonicalPath="/posts/">
  <main class="archive-shell" id="main-content">
    <section class="archive-heading">
      <p class="eyebrow">archive</p>
      <h1>posts</h1>
      <p>Every public note from Nimdal's personal blog, sorted from newest to oldest.</p>
    </section>
    <section class="post-grid" aria-label="All posts">
      {posts.map((post) => <PostCard post={post} />)}
    </section>
  </main>
</BaseLayout>
