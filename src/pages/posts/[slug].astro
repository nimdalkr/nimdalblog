---
import { getCollection, render } from "astro:content";

import PostCard from "../../components/PostCard.astro";
import { absoluteUrl, projectLinks, site } from "../../config";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  estimateReadingTime,
  formatDate,
  getPostPath,
  getPublishedPosts,
  getRelatedPosts,
  tagToSlug
} from "../../utils/posts";

export async function getStaticPaths() {
  const posts = getPublishedPosts(await getCollection("posts"));

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, posts }
  }));
}

const { post, posts } = Astro.props;
const { Content, headings } = await render(post);
const related = getRelatedPosts(posts, post);
const readingTime = estimateReadingTime(post.body ?? "", post.data.lang);
const canonicalPath = getPostPath(post);
const cover = post.data.cover ?? "/media/identity-octopus.jpg";
const coverAlt = post.data.coverAlt ?? "";
const project = post.data.relatedProject
  ? projectLinks[post.data.relatedProject as keyof typeof projectLinks]
  : undefined;
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.description,
  image: absoluteUrl(cover),
  url: post.data.canonicalUrl ?? absoluteUrl(canonicalPath),
  datePublished: post.data.publishedAt.toISOString(),
  dateModified: (post.data.updatedAt ?? post.data.publishedAt).toISOString(),
  keywords: post.data.tags,
  inLanguage: post.data.lang,
  author: {
    "@type": "Person",
    name: site.author,
    url: site.mainUrl
  },
  publisher: {
    "@type": "Person",
    name: site.author,
    url: site.mainUrl
  },
  isPartOf: {
    "@type": "Blog",
    name: site.title,
    url: site.url
  },
  mainEntityOfPage: post.data.canonicalUrl ?? absoluteUrl(canonicalPath)
};
const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: site.title,
      item: site.url
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "posts",
      item: absoluteUrl("/posts/")
    },
    {
      "@type": "ListItem",
      position: 3,
      name: post.data.title,
      item: post.data.canonicalUrl ?? absoluteUrl(canonicalPath)
    }
  ]
};
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  image={cover}
  imageAlt={coverAlt}
  canonicalPath={canonicalPath}
  canonicalUrl={post.data.canonicalUrl}
  ogType="article"
  lang={post.data.lang}
  noindex={post.data.noindex}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  <main class="article-shell" id="main-content">
    <article class="article">
      <header class="article-header">
        <a class="back-link" href="/">nimdalog</a>
        <p class="eyebrow">{post.data.heroLabel ?? post.data.series ?? post.data.category}</p>
        <h1>{post.data.title}</h1>
        <p>{post.data.description}</p>
        <div class="post-meta">
          <time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt, post.data.lang)}</time>
          <span>{readingTime}</span>
          <span>{post.data.proofLevel}</span>
        </div>
        <div class="post-tags" aria-label="Post tags">
          {post.data.tags.map((tag) => <a href={`/tags/${tagToSlug(tag)}/`}>{tag}</a>)}
        </div>
      </header>

      <aside class="article-proof-strip" aria-label="Post proof status">
        <div>
          <span>Series</span>
          <strong>{post.data.series ?? post.data.category}</strong>
        </div>
        <div>
          <span>Proof</span>
          <strong>{post.data.proofLevel}</strong>
        </div>
        <div>
          <span>Bridge</span>
          <strong>{project?.label ?? "archive note"}</strong>
        </div>
      </aside>

      {project && (
        <aside class="case-room-bridge" id="case-room-proof" aria-label="Case room proof bridge">
          <div>
            <span>Case room proof</span>
            <strong>{project.label}</strong>
            <p>This article is the proof layer connected to the portfolio case room.</p>
          </div>
          <a href={project.href}>Return to proof room</a>
        </aside>
      )}

      <figure class="article-cover">
        <img
          src={cover}
          alt={coverAlt}
          width="1280"
          height="720"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      </figure>

      {(post.data.summaryBullets.length > 0 || toc.length > 0 || project) && (
        <aside class="article-brief" aria-label="Article brief">
          {post.data.summaryBullets.length > 0 && (
            <section class="article-brief-summary-desktop">
              <h2>Field summary</h2>
              <ul>
                {post.data.summaryBullets.map((item) => <li>{item}</li>)}
              </ul>
            </section>
          )}
          {post.data.summaryBullets.length > 0 && (
            <details class="article-brief-summary-mobile">
              <summary>
                <span>Field summary</span>
                <strong>{post.data.summaryBullets.length} field notes</strong>
              </summary>
              <ul>
                {post.data.summaryBullets.map((item) => <li>{item}</li>)}
              </ul>
            </details>
          )}
          {toc.length > 0 && (
            <section class="article-brief-contents">
              <h2>Contents</h2>
              <nav aria-label="Article table of contents">
                {toc.map((heading) => (
                  <a class={`toc-depth-${heading.depth}`} href={`#${heading.slug}`}>{heading.text}</a>
                ))}
              </nav>
            </section>
          )}
          {project && (
            <section class="project-bridge">
              <h2>Related project</h2>
              <a href={project.href}>
                <span>Related project</span>
                <strong>{project.label}</strong>
              </a>
            </section>
          )}
        </aside>
      )}

      <div class="prose">
        <Content />
      </div>
    </article>

    {related.length > 0 && (
      <aside class="related" aria-label="Related posts">
        <p class="eyebrow">more</p>
        {related.map((item) => <PostCard post={item} />)}
      </aside>
    )}
  </main>
</BaseLayout>
