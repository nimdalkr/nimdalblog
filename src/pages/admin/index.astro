---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { POST_CATEGORIES } from "../../utils/postMarkdown";
---

<BaseLayout title="admin" description="Nimdal blog editor." canonicalPath="/admin/" noindex>
  <main class="admin-shell">
    <section class="admin-panel admin-gate" id="admin-gate">
      <div>
        <p class="eyebrow">admin</p>
        <h1>Write blog posts</h1>
        <p id="auth-copy">Sign in with the approved GitHub account to publish posts.</p>
      </div>
      <a class="admin-button" id="login-link" href="/api/auth/login/">Sign in with GitHub</a>
    </section>

    <section class="admin-panel admin-workspace" id="admin-workspace" hidden>
      <div class="admin-toolbar">
        <div>
          <p class="eyebrow">editor</p>
          <h1>blog admin</h1>
          <p id="admin-user"></p>
        </div>
        <div class="admin-actions">
          <button class="admin-button admin-button-ghost" id="new-post" type="button">New</button>
          <button class="admin-button admin-button-ghost" id="logout" type="button">Logout</button>
        </div>
      </div>

      <div class="admin-grid">
        <aside class="admin-list">
          <div class="section-heading">
            <div>
              <p class="section-kicker">repository</p>
              <h2>Posts</h2>
            </div>
          </div>
          <div id="post-list" class="post-list"></div>
        </aside>

        <form class="admin-editor" id="post-form">
          <input id="sha" name="sha" type="hidden" />
          <div class="field-grid">
            <label>
              <span>Slug</span>
              <input id="slug" name="slug" autocomplete="off" placeholder="my-post-slug" />
            </label>
            <label>
              <span>Published</span>
              <input id="publishedAt" name="publishedAt" type="date" required />
            </label>
          </div>

          <label>
            <span>Title</span>
            <input id="title" name="title" required placeholder="Post title" />
          </label>

          <label>
            <span>Description</span>
            <textarea id="description" name="description" rows="3" required placeholder="Short search/social summary"></textarea>
          </label>

          <div class="field-grid">
            <label>
              <span>Category</span>
              <select id="category" name="category">
                {POST_CATEGORIES.map((category) => <option value={category}>{category}</option>)}
              </select>
            </label>
            <label>
              <span>Language</span>
              <select id="lang" name="lang">
                <option value="en">en</option>
                <option value="ko">ko</option>
              </select>
            </label>
          </div>

          <label>
            <span>Tags</span>
            <input id="tags" name="tags" placeholder="web3, product, research" />
          </label>

          <div class="field-grid">
            <label>
              <span>Cover</span>
              <input id="cover" name="cover" placeholder="/media/identity-octopus.jpg" />
            </label>
            <label>
              <span>Cover alt</span>
              <input id="coverAlt" name="coverAlt" placeholder="Image description" />
            </label>
          </div>

          <div class="check-row">
            <label>
              <input id="featured" name="featured" type="checkbox" />
              <span>Featured</span>
            </label>
            <label>
              <input id="draft" name="draft" type="checkbox" />
              <span>Draft</span>
            </label>
          </div>

          <label>
            <span>Body</span>
            <textarea id="body" name="body" class="markdown-body-input" required placeholder="Write Markdown here..."></textarea>
          </label>

          <div class="admin-editor-actions">
            <button class="admin-button" type="submit">Save post</button>
            <button class="admin-button admin-button-danger" id="delete-post" type="button">Delete</button>
            <p id="save-status" role="status"></p>
          </div>
        </form>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  const state = {
    posts: [],
    slugTouched: false
  };

  const elements = {
    gate: document.querySelector("#admin-gate"),
    workspace: document.querySelector("#admin-workspace"),
    authCopy: document.querySelector("#auth-copy"),
    loginLink: document.querySelector("#login-link"),
    user: document.querySelector("#admin-user"),
    list: document.querySelector("#post-list"),
    form: document.querySelector("#post-form"),
    status: document.querySelector("#save-status"),
    logout: document.querySelector("#logout"),
    newPost: document.querySelector("#new-post"),
    deletePost: document.querySelector("#delete-post")
  };

  const fields = {
    sha: document.querySelector("#sha"),
    slug: document.querySelector("#slug"),
    title: document.querySelector("#title"),
    description: document.querySelector("#description"),
    publishedAt: document.querySelector("#publishedAt"),
    category: document.querySelector("#category"),
    lang: document.querySelector("#lang"),
    tags: document.querySelector("#tags"),
    cover: document.querySelector("#cover"),
    coverAlt: document.querySelector("#coverAlt"),
    featured: document.querySelector("#featured"),
    draft: document.querySelector("#draft"),
    body: document.querySelector("#body")
  };

  init();

  elements.form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    await savePost();
  });

  elements.newPost?.addEventListener("click", () => {
    resetForm();
  });

  elements.deletePost?.addEventListener("click", async () => {
    const slug = fields.slug.value.trim();
    if (!slug || !confirm(`Delete ${slug}?`)) return;

    setStatus("Deleting...");
    await api(`/api/admin/posts/?slug=${encodeURIComponent(slug)}`, { method: "DELETE" });
    resetForm();
    await loadPosts();
    setStatus("Deleted.");
  });

  elements.logout?.addEventListener("click", async () => {
    await fetch("/api/auth/logout/", { method: "POST" });
    window.location.href = "/admin/";
  });

  fields.slug?.addEventListener("input", () => {
    state.slugTouched = true;
  });

  fields.title?.addEventListener("input", () => {
    if (!state.slugTouched) {
      fields.slug.value = slugify(fields.title.value);
    }
  });

  async function init() {
    resetForm();
    const response = await fetch("/api/auth/me/");
    const data = await response.json();

    if (!data.configured) {
      elements.authCopy.textContent = `Missing Vercel environment variables: ${data.missing.join(", ")}`;
      elements.loginLink.hidden = true;
      return;
    }

    if (!data.authenticated) {
      elements.authCopy.textContent = "Only the approved GitHub account can publish posts.";
      return;
    }

    elements.gate.hidden = true;
    elements.workspace.hidden = false;
    elements.user.textContent = `Signed in as ${data.user.login}`;
    await loadPosts();
  }

  async function loadPosts() {
    elements.list.innerHTML = "<p class=\"muted-note\">Loading...</p>";
    const data = await api("/api/admin/posts/");
    state.posts = data.posts;
    elements.list.innerHTML = "";

    if (state.posts.length === 0) {
      elements.list.innerHTML = "<p class=\"muted-note\">No posts yet.</p>";
      return;
    }

    for (const post of state.posts) {
      const button = document.createElement("button");
      button.type = "button";
      button.className = "post-list-item";
      button.dataset.slug = post.slug;
      button.innerHTML = `
        <strong>${escapeHtml(post.title || post.slug)}</strong>
        <span>${escapeHtml(post.slug)} · ${escapeHtml(post.category)}${post.draft ? " · draft" : ""}</span>
      `;
      button.addEventListener("click", () => loadPost(post.slug));
      elements.list.append(button);
    }
  }

  async function loadPost(slug) {
    setStatus("Loading...");
    const data = await api(`/api/admin/posts/?slug=${encodeURIComponent(slug)}`);
    fillForm(data.post);
    setStatus("Loaded.");
  }

  async function savePost() {
    const post = collectForm();
    setStatus("Saving...");
    const data = await api("/api/admin/posts/", {
      method: "POST",
      headers: {
        "Content-Type": "application/json"
      },
      body: JSON.stringify(post)
    });

    fillForm(data.post);
    await loadPosts();
    setStatus(data.commit ? `Saved. Commit: ${data.commit}` : "Saved.");
  }

  function resetForm() {
    state.slugTouched = false;
    fields.sha.value = "";
    fields.slug.value = "";
    fields.title.value = "";
    fields.description.value = "";
    fields.publishedAt.value = new Date().toISOString().slice(0, 10);
    fields.category.value = "note";
    fields.lang.value = "en";
    fields.tags.value = "";
    fields.cover.value = "/media/identity-octopus.jpg";
    fields.coverAlt.value = "Nimdal pixel octopus identity.";
    fields.featured.checked = false;
    fields.draft.checked = false;
    fields.body.value = "Start writing here.\n\n## Section\n\n";
    setStatus("");
  }

  function fillForm(post) {
    state.slugTouched = true;
    fields.sha.value = post.sha || "";
    fields.slug.value = post.slug || "";
    fields.title.value = post.title || "";
    fields.description.value = post.description || "";
    fields.publishedAt.value = post.publishedAt || new Date().toISOString().slice(0, 10);
    fields.category.value = post.category || "note";
    fields.lang.value = post.lang || "en";
    fields.tags.value = Array.isArray(post.tags) ? post.tags.join(", ") : "";
    fields.cover.value = post.cover || "/media/identity-octopus.jpg";
    fields.coverAlt.value = post.coverAlt || "";
    fields.featured.checked = Boolean(post.featured);
    fields.draft.checked = Boolean(post.draft);
    fields.body.value = post.body || "";
  }

  function collectForm() {
    return {
      sha: fields.sha.value,
      slug: fields.slug.value,
      title: fields.title.value,
      description: fields.description.value,
      publishedAt: fields.publishedAt.value,
      category: fields.category.value,
      lang: fields.lang.value,
      tags: fields.tags.value.split(",").map((tag) => tag.trim()).filter(Boolean),
      cover: fields.cover.value,
      coverAlt: fields.coverAlt.value,
      featured: fields.featured.checked,
      draft: fields.draft.checked,
      body: fields.body.value
    };
  }

  async function api(path, options = {}) {
    const response = await fetch(path, options);
    const data = await response.json().catch(() => ({}));

    if (!response.ok) {
      throw new Error(data.message || data.error || "Request failed.");
    }

    return data;
  }

  function setStatus(message) {
    elements.status.textContent = message;
  }

  function slugify(value) {
    return value
      .trim()
      .toLowerCase()
      .replace(/&/g, "and")
      .replace(/[^a-z0-9]+/g, "-")
      .replace(/^-+|-+$/g, "");
  }

  function escapeHtml(value) {
    return String(value)
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;")
      .replaceAll("'", "&#039;");
  }
</script>
