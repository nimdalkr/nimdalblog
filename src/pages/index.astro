---
import { getCollection } from "astro:content";

import PostCard from "../components/PostCard.astro";
import { absoluteUrl, projectLinks, series as seriesList, site } from "../config";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPostPath, getPublishedPosts, getTags } from "../utils/posts";

const posts = getPublishedPosts(await getCollection("posts"));
const featured = posts.find((post) => post.data.featured) ?? posts[0];
const rest = posts.filter((post) => post.id !== featured?.id);
const tags = getTags(posts);
const proofPosts = posts.filter((post) => post.data.proofLevel && post.data.proofLevel !== "none");
const connectedPosts = posts.filter((post) => post.data.relatedProject);
const visualPosts = posts.filter((post) => post.data.cover);
const proofLedger = [
  { label: "Published notes", value: posts.length, detail: "public archive entries" },
  { label: "Proof-backed", value: proofPosts.length, detail: "posts with evidence status" },
  { label: "Project bridges", value: connectedPosts.length, detail: "linked to nimdal.xyz rooms" },
  { label: "Visual records", value: visualPosts.length, detail: "posts with captured media" }
];
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      name: site.title,
      url: site.url,
      description: site.description
    },
    {
      "@type": "Blog",
      name: site.title,
      url: site.url,
      description: site.description,
      author: {
        "@type": "Person",
        name: site.author,
        url: site.mainUrl
      },
      blogPost: posts.map((post) => ({
        "@type": "BlogPosting",
        headline: post.data.title,
        url: absoluteUrl(getPostPath(post)),
        datePublished: post.data.publishedAt.toISOString()
      }))
    },
    {
      "@type": "Person",
      name: site.author,
      url: site.mainUrl,
      email: site.email
    }
  ]
};
---

<BaseLayout title="nimdalog" description={site.description} canonicalPath="/">
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <main class="home-shell" id="main-content">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-cover" aria-hidden="true">
        <div class="hero-cover-copy">
          <span>nimdal notes</span>
          <strong>research / product / automation</strong>
          <small>web3 field notes and build logs</small>
        </div>
        <i class="cover-pixel cover-pixel-a"></i>
        <i class="cover-pixel cover-pixel-b"></i>
        <i class="cover-pixel cover-pixel-c"></i>
      </div>
      <div class="hero-profile">
        <img class="hero-avatar" src="/media/identity-octopus.jpg" alt="Nimdal pixel octopus identity" />
        <p class="eyebrow">Nimdal's personal log</p>
        <h1 id="hero-title">nimdalog</h1>
      </div>
    </section>

    <section class="editorial-desk" aria-label="nimdalog editorial system">
      <div>
        <p class="section-kicker">logbook desk</p>
        <h2>Build logs, research notes, and operating manuals.</h2>
        <p>
          nimdalog is the proof layer behind Nimdal's portfolio: what was built, why it mattered,
          what evidence exists, and what still needs to be improved.
        </p>
      </div>
      <a class="desk-link" href={site.mainUrl}>Return to portfolio</a>
    </section>

    <section class="proof-ledger" aria-label="nimdalog proof ledger">
      <div class="ledger-copy">
        <p class="section-kicker">proof ledger</p>
        <h2>Every post should carry a reason to exist.</h2>
      </div>
      <div class="ledger-grid">
        {proofLedger.map((item) => (
          <article>
            <strong>{item.value}</strong>
            <span>{item.label}</span>
            <p>{item.detail}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="series-rail" aria-label="Editorial series">
      {seriesList.map((item) => (
        <article>
          <span>{item.id}</span>
          <h2>{item.label}</h2>
          <p>{item.description}</p>
        </article>
      ))}
    </section>

    <div class="home-layout">
      <section class="home-main" aria-label="Latest posts">
        <div class="section-heading">
          <div>
            <p class="section-kicker">all posts</p>
            <h2>Latest notes</h2>
          </div>
          <a class="back-link" href="/posts/">View archive</a>
        </div>

        {featured && (
          <section class="featured-section" aria-label="Featured post">
            <PostCard post={featured} featured />
          </section>
        )}

        {rest.length > 0 && (
          <section class="post-grid" aria-label="Recent posts">
            {rest.map((post) => <PostCard post={post} />)}
          </section>
        )}
      </section>

      <aside class="home-side" aria-label="Blog navigation">
        <section class="side-card project-bridge-card">
          <h2>Project bridge</h2>
          <p>Posts connect back to public portfolio rooms when there is project-level proof.</p>
          <div class="project-link-list">
            {Object.values(projectLinks).map((project) => <a href={project.href}>{project.label}</a>)}
          </div>
        </section>
        <section class="side-card">
          <h2>Categories</h2>
          <div class="tag-strip" aria-label="Tags">
            <a class="is-active" href="/">all</a>
            {tags.map((tag) => <a href={`/tags/${tag.slug}/`}>{tag.label}<span>{tag.count}</span></a>)}
          </div>
        </section>
        <section class="side-card">
          <h3>About Nimdal</h3>
          <p>
            Builder and strategist from Seoul, focused on research tools, marketing operations, automation, and game-like product systems.
          </p>
        </section>
      </aside>
    </div>
  </main>
</BaseLayout>
