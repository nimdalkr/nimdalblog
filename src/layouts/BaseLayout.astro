---
import { SITE } from "../config";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${SITE.title} | Personal Blog`,
  description = SITE.description
} = Astro.props;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <title>{title}</title>
    <style>
      html,
      body {
        margin: 0;
        min-height: 100%;
        background: #ffffff;
      }
    </style>
  </head>
  <body></body>
</html>
